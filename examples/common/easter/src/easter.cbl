       IDENTIFICATION DIVISION.
      *> ***************************************************************
      *> AUTHOR:    ΝIKOS ΟIKONOMOPOULOS
      *> DATE:      8/5/2018
      *> PURPOSE:   CALCULATE THE EASTERN CHURCH MOVEABLE FEASTS
      *> TECTONICS: COBC -X EASTER.CBL
      *> USAGE    : EASTER [ETOS]
      *> ***************************************************************
       PROGRAM-ID. EASTER.
       ENVIRONMENT DIVISION.

       CONFIGURATION SECTION.

       SOURCE-COMPUTER.  OPENCOBOL.
       OBJECT-COMPUTER.  OPENCOBOL.
       SPECIAL-NAMES.
            DECIMAL-POINT IS COMMA.
       INPUT-OUTPUT SECTION.

       FILE-CONTROL.
       SELECT REPORT-FILE ASSIGN TO DISK REPORT-NAME
       ORGANIZATION IS LINE SEQUENTIAL
       ACCESS MODE IS SEQUENTIAL.

       DATA DIVISION.
       FILE SECTION.
       FD  REPORT-FILE
           BLOCK CONTAINS 1 RECORDS
           DATA RECORD IS REPORT-RECORD.

       01  REPORT-RECORD PICTURE X(60) VALUE SPACES.

       WORKING-STORAGE SECTION.
       01 REPORT-NAME.
          05 FILLER   PICTURE X(9) VALUE "MV_FEASTS".
          05 FIL-ETOS PICTURE 9(4).
          05 FILLER   PICTURE X(4) VALUE ".TXT".

       01 REPORT-LINE.
          05 RP1      PICTURE X(40) VALUE SPACES.
          05 RP2      PICTURE X(12) VALUE SPACES.
       01 A    PICTURE 9(8).
       01 B    PICTURE 9(8).
       01 C    PICTURE 9(8).
       01 C1   PICTURE 9(8).
       01 D    PICTURE 9(8).
       01 D1   PICTURE 9(8).
       01 Z    PICTURE 9(8).
       01 HP   PICTURE 9(8).
       01 F0   PICTURE 9(8).
       01 F1   PICTURE 9(4).
       01 F2   PICTURE 9(4).
       01 F3   PICTURE 9(4).
       01 HMERA.
          02  HM     PICTURE 9(2).
          02  FILLER PICTURE X VALUE "/".
          02  MN     PICTURE 9(2).
          02  FILLER PICTURE X VALUE "/".
          02  ETOS   PICTURE 9(4).

       01 ARGS PICTURE X(80).
       01 JJ1.
          02 JJ-Y  PICTURE 9(4).
          02 JJ-D  PICTURE 9(3).
       01 JJ PICTURE 9(7).
       01 GG  PICTURE 9(8).
       01 DD  PICTURE 9(8).
       01 LEAP PICTURE 9.
      *> 0 = LEAP 1 = NON LEAP
       01 WCR PICTURE X.
      *> ***************************************************************
       PROCEDURE DIVISION.
       ACCEPT ARGS FROM COMMAND-LINE END-ACCEPT
       IF ARGS NOT EQUAL SPACES
           MOVE ARGS TO ETOS
      *>     DISPLAY "COMMAND LINE  :" ETOS END-DISPLAY
       ELSE
           DISPLAY "ETOS: "  END-DISPLAY
           ACCEPT ETOS END-ACCEPT

       END-IF
       MOVE ETOS TO FIL-ETOS RP2
       OPEN OUTPUT REPORT-FILE
       MOVE "MOVEABLE FEASTS OF EASTERN CHRISTIANITY:" TO RP1
       WRITE REPORT-RECORD FROM REPORT-LINE
       MOVE ALL "-" TO REPORT-LINE
       WRITE REPORT-RECORD FROM REPORT-LINE

      *> ***************************************************************
      *>DISPLAY "STEP # 1 LEAP" END-DISPLAY
       COMPUTE F0 = FUNCTION MOD(ETOS 4)      END-COMPUTE
       COMPUTE F1 = FUNCTION MOD(ETOS 400)    END-COMPUTE
       COMPUTE F2 = FUNCTION MOD(ETOS 100)    END-COMPUTE
      *>DISPLAY "STEP #1 DIVIDE END" END-DISPLAY
       IF F1 = 0 OR (F2 NOT EQUAL 0 AND F0 = 0)
           MOVE 0 TO LEAP
       ELSE
           MOVE 1 TO LEAP
       END-IF
      *>
       COMPUTE A = FUNCTION MOD(ETOS 19)           END-COMPUTE
      *>DIVIDE ETOS BY 19 GIVING F2 REMAINDER A END-DIVIDE
       COMPUTE B = FUNCTION MOD(ETOS 4)            END-COMPUTE
       COMPUTE C = FUNCTION MOD(ETOS 7)            END-COMPUTE
       COMPUTE C1 = (19 * A) + 16                  END-COMPUTE
       COMPUTE D = FUNCTION MOD(C1 30)             END-COMPUTE
      *>DISPLAY "D " D
       COMPUTE D1 = (4 * C) + (2 * B) + (6 * D)    END-COMPUTE
       COMPUTE Z = FUNCTION MOD(D1 7)              END-COMPUTE
       COMPUTE HP = D + Z + 3                      END-COMPUTE
       DISPLAY "PASCHA IN APRIL DAYS : " HP  END-DISPLAY

       INITIALISE REPORT-LINE
       MOVE "PASCHA IN APRIL DAYS:"       TO RP1
       MOVE HP                            TO RP2
       WRITE REPORT-RECORD FROM REPORT-LINE

       IF HP <= 30
          MOVE 4 TO MN
          MOVE HP TO HM
       END-IF
       IF HP > 30
           MOVE 5 TO MN
           SUBTRACT 30 FROM HP GIVING HM END-SUBTRACT
       END-IF
       DISPLAY  "PASCHA: " HM "/" MN "/" ETOS  END-DISPLAY
       INITIALISE REPORT-LINE
       MOVE "PASCHA:" TO RP1
       MOVE  HMERA    TO RP2
       WRITE REPORT-RECORD FROM REPORT-LINE
       MOVE  0 TO JJ-D
       MOVE ETOS TO JJ-Y
       ADD 31 28 31 HP TO JJ-D
       IF LEAP = 0
          ADD 1 TO JJ-D
       END-IF
      *> +50 FROM PASCHA IS MONDAY OF THE HOLY SPIRIT
       ADD 50 TO JJ-D
       MOVE JJ1 TO JJ
       COMPUTE DD = FUNCTION INTEGER-OF-DAY(JJ)   END-COMPUTE
       COMPUTE GG = FUNCTION DATE-OF-INTEGER(DD)  END-COMPUTE
       MOVE GG(5:2) TO MN
       MOVE GG(7:2) TO HM
       DISPLAY "MONDAY OF THE HOLY SPIRIT: " HM "/" MN "/" ETOS
       END-DISPLAY
       INITIALISE REPORT-LINE
       MOVE "MONDAY OF THE HOLY SPIRIT:" TO RP1
       MOVE  HMERA                       TO RP2
       WRITE REPORT-RECORD FROM REPORT-LINE
      *> -48 FROM PASCHA IS CLEAN MONDAY
      *>UNDO PREV
       SUBTRACT 50 FROM JJ-D
       SUBTRACT 48 FROM JJ-D
       MOVE JJ1 TO JJ
       COMPUTE DD = FUNCTION INTEGER-OF-DAY(JJ)   END-COMPUTE
       COMPUTE GG = FUNCTION DATE-OF-INTEGER(DD)  END-COMPUTE
       MOVE GG(5:2) TO MN
       MOVE GG(7:2) TO HM
       DISPLAY  "CLEAN MONDAY:" HM "/" MN "/" ETOS  END-DISPLAY
       INITIALISE REPORT-LINE
       MOVE "CLEAN MONDAY:" TO RP1
       MOVE  HMERA                         TO RP2
       WRITE REPORT-RECORD FROM REPORT-LINE
      *> -2 FROM PASCHA IS GREAT AND HOLY FRIDAY
      *>UNDO PREV
       ADD 48 TO JJ-D
       SUBTRACT 2 FROM JJ-D
       MOVE JJ1 TO JJ
       COMPUTE DD = FUNCTION INTEGER-OF-DAY(JJ)   END-COMPUTE
       COMPUTE GG = FUNCTION DATE-OF-INTEGER(DD)  END-COMPUTE
       MOVE GG(5:2) TO MN
       MOVE GG(7:2) TO HM
       DISPLAY  "GREAT AND HOLY FRIDAY: " HM "/" MN "/" ETOS END-DISPLAY
       INITIALISE REPORT-LINE
       MOVE "GREAT AND HOLY FRIDAY: "      TO RP1
       MOVE  HMERA                         TO RP2
       WRITE REPORT-RECORD FROM REPORT-LINE
      *> + 1 FROM PASCHA IS BRIGHT MONDAY
      *>UNDO PREV
       ADD 2 TO JJ-D
       ADD 1 TO JJ-D
       MOVE JJ1 TO JJ
       COMPUTE DD = FUNCTION INTEGER-OF-DAY(JJ)   END-COMPUTE
       COMPUTE GG = FUNCTION DATE-OF-INTEGER(DD)  END-COMPUTE
       MOVE GG(5:2) TO MN
       MOVE GG(7:2) TO HM
       DISPLAY  "BRIGHT MONDAY:" HM "/" MN "/" ETOS  END-DISPLAY
       INITIALISE REPORT-LINE
       MOVE "BRIGHT MONDAY:" TO RP1
       MOVE  HMERA                         TO RP2
       WRITE REPORT-RECORD FROM REPORT-LINE
       CLOSE REPORT-FILE
       DISPLAY "FILE :" REPORT-NAME
       " WITH MOVEABLE FEASTS OF EASTERN CHRISTIANITY CREATED."
       END-DISPLAY
       GOBACK.
       END PROGRAM EASTER.
