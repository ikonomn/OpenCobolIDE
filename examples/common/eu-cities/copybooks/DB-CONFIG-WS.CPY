       01 DB-CONFIG-PATH     PIC X(512) VALUE SPACES.
       01 DB-FLAG            PIC X(2) VALUE "00".
          88 SQLITE          VALUE "00".
          88 MARIADB         VALUE "01".
       01 CURRENT-STEP       PIC X(24) VALUE SPACES.
       01 SQL-ERROR-ACTION   PIC X VALUE SPACE.
          88 SQL-ERROR-RETRY     VALUE "R".
          88 SQL-ERROR-DUPLICATE VALUE "D".
          88 SQL-ERROR-FATAL     VALUE "F".
       01 DB-CONFIG-STATUS   PIC XX VALUE SPACES.
       01 DB-CONFIG-OK-FLAG PIC X VALUE "N".
          88 DB-CONFIG-OK VALUE "Y".
       01 DATASRC            PIC X(512) VALUE SPACES.
       01 DB-USER            PIC X(64) VALUE SPACES.
       01 DB-PASSWORD        PIC X(64) VALUE SPACES.
       01 COUNTRIES-PATH     PIC X(512) VALUE SPACES.
       01 CITIES-PATH        PIC X(512) VALUE SPACES.
